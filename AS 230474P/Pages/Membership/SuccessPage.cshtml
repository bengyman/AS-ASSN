@page
@model AS_230474P.Pages.Membership.SuccessPageModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Success</title>
    <style>
        .logout-button {
            background-color: red;
            color: white;
            padding: 10px 15px;
            border: none;
            cursor: pointer;
            font-size: 16px;
        }

        .logout-button:hover {
            background-color: darkred;
        }
    </style>
</head>
<body>
    <h1>Registration Successful!</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <h2>User Details</h2>

    @if (Model.Registration != null)
    {
        <p><strong>First Name:</strong> @Model.Registration.FirstName</p>
        <p><strong>Last Name:</strong> @Model.Registration.LastName</p>
        <p><strong>Email:</strong> @Model.Registration.Email</p>
        <p><strong>Gender:</strong> @Model.Registration.Gender</p>
        <p><strong>Date of Birth:</strong> @Model.Registration.DateOfBirth.ToString("MM/dd/yyyy")</p>
        <p><strong>Who Am I:</strong> @Model.Registration.WhoAmI</p>

        @if (!string.IsNullOrEmpty(Model.Registration.ResumeFilePath))
        {
            <p><strong>Resume:</strong> <a href="@Model.Registration.ResumeFilePath" target="_blank">Download Resume</a></p>
        }
        else
        {
            <p><strong>Resume:</strong> No resume uploaded.</p>
        }
    }
    else
    {
        <p>No registration details available.</p>
    }

    <form method="post">
        <button type="submit" asp-page-handler="Logout" class="logout-button">Logout</button>
    </form>
</body>
</html>
